# Copy to .env.neon and fill in. .env.neon is gitignored and must never be committed.
#
# Operator credentials for neonctl (branch create/delete, point-in-time restore). Not loaded by
# docker-compose or the app: compose env_file sends the root .env into the backend, so these stay
# in their own file.
#
# Generate NEON_API_KEY in the Neon console: project -> Settings -> API Keys. Use a project-scoped
# key, not an account-wide personal key. scripts/restore-drill.sh, scripts/offsite-backup.sh, and
# scripts/neon-watch.sh read this name.
NEON_API_KEY=

# Nothing in the repo reads these. NEON_DATA_API_KEY is a separate Neon key; RESTORE_DRILL_CONNSTRING
# is unused because the restore drill creates a branch and reads that branch's own connection string.
NEON_DATA_API_KEY=
RESTORE_DRILL_CONNSTRING=
