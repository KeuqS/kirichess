  "docModel": {
    "$comment": [
      "Playtesting-derived constants used to compute the explanatory tables on the rules page and in",
      "docs/RULES.md. These are modelling assumptions, not engine rules, the engine never reads this",
      "block. They exist here so the published tables recompute themselves when a rule number changes,",
      "instead of going quietly stale."
    ],
    "movesPerPlayer": 40,
    "moveFrequency": {
      "$comment": "Share of a player's moves made by each piece, from playtested games. Must sum to 1.",
      "pawn": 0.3,
      "knight": 0.14,
      "bishop": 0.14,
      "rook": 0.19,
      "queen": 0.12,
      "king": 0.11
    },
    "materialTradedPoints": {
      "$comment": "Piece-value points each player loses to captures in a typical game; drives the Burn/Bounty drain estimate.",
      "value": 15
    },
