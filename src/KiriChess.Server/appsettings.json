      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Auth": {
    "ExternalCodeLifetimeSeconds": 60
  },
  "Email": {
    "ApiKey": "",
    "FromAddress": "",
    "FromName": "KiriChess",
    "TimeoutSeconds": 10,
    "MaxAttempts": 4,
    "QueueCapacity": 512
  },
  "Vapid": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": ""
  },
  "Stripe": {
    "WebhookSecret": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Sentry": {
    "Dsn": "",
    "Environment": ""
  },
  "Metrics": {
    "Port": 0,
    "ScrapeToken": ""
  },
  "Turnstile": {
    "SecretKey": "",
    "TimeoutSeconds": 5
  },
