    <RootNamespace>KiriChess.Simulator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KiriChess.Engine\KiriChess.Engine.csproj" />
  </ItemGroup>
</Project>
