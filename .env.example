# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Minimum for a real instance (everything else below has a working default or fails closed
# when empty): Jwt__Key, ConnectionStrings__Postgres, Frontend__BaseUrl, NEXT_PUBLIC_API_BASE,
# NEXT_PUBLIC_SITE_URL, Cors__AllowedOrigins__0. Leaving Frontend__BaseUrl at its localhost
# default sends account emails with localhost links and points every exported game's PGN Site
# tag (src/KiriChess.Server/Games/PgnBuilder.cs) at a replay URL nobody outside the box can open.

# --- Database ---
POSTGRES_PASSWORD=change-me
ConnectionStrings__Postgres=Host=db;Port=5432;Database=kirichess;Username=postgres;Password=change-me
# Optional owner role for `dotnet KiriChess.Server.dll --migrate` (C-12-4). Leave unset when the
# serving role can already migrate, which is local Postgres and compose.
# ConnectionStrings__Migrator=

# --- Auth ---
# At least 32 bytes. Generate one with: openssl rand -base64 48
# PowerShell (no openssl on stock Windows): $b=New-Object byte[] 48;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
Jwt__Key=replace-with-a-32-byte-minimum-random-secret
# Empty = the check is skipped and any password is accepted (subject to Identity's own complexity
# rules). Set true to reject a password found in a known-breach corpus at registration/change time.
Auth__BreachedPasswordCheckEnabled=false
# Empty/false = login is not gated on email confirmation. Production sets this true; the E2E stack
# does too, since a suite that never turns this on would not prove the confirm-email flow is real.
Auth__RequireConfirmedEmail=false
# Empty = the confirmed-email PLAY gate is off. This is separate from the login gate above, and it
# is the one that actually makes a confirmed address a precondition for a game: /api/auth/register
# issues a token pair unconditionally, so a new account plays a whole first session before the login
# gate is ever consulted. Set it to an ISO-8601 instant and accounts created at or after that moment
# must confirm before they can queue, create a game, or accept a challenge or rematch; accounts
# created before it are grandfathered forever, so turning this on cannot lock out existing players.
# A value that does not parse fails OFF (logged as an error), never closed. Signup, /learn, /rules
# and spectating stay open to an unconfirmed account either way.
Auth__RequireConfirmedEmailForPlayFrom=
# Google sign-in (Phase 6b.3). Both empty = the Google button on /login is inert; a client needs its
# own OAuth client with redirect URI https://api.kirichess.com/signin-google (or the equivalent
# non-production host) - see docs/ops/PROVIDER-ACCOUNTS.md.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
# Cloudflare Turnstile server-side check on /api/auth/register (DH.3), same fail-closed pattern as
# every other key below: empty = the check is skipped and any POST is accepted. Get the secret key
# from the Cloudflare dashboard for the same widget as NEXT_PUBLIC_TURNSTILE_SITE_KEY below - see
# docs/ops/DEPLOYMENT.md § 9.1.
Turnstile__SecretKey=

# --- CORS: one origin per index, no trailing slash ---
Cors__AllowedOrigins__0=http://localhost:3000

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
RunMigrationsOnStartup=false

# --- Observability (Phase 6d) ---
# Empty DSN = Sentry is not registered at all. Fill in only once a real Sentry project exists.
Sentry__Dsn=
# /metrics is not served unless one of these is set. Under compose there is no port isolation, so
# use the token; generate one with: openssl rand -hex 32
# PowerShell: $b=New-Object byte[] 32;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);($b|%{$_.ToString('x2')}) -join ''
Metrics__ScrapeToken=
# Production only (fly.backend.toml). Empty here: local and staging serve on *.fly.dev as the
# real hostname, and locking it would 404 every request that is not /health or /metrics.
OriginLock__BlockedHosts__0=
# Empty = the allow-list is off (local and compose, any Host). fly.backend.toml sets
# api.kirichess.com; fly.backend.staging.toml sets that app's fly.dev name. /health and /metrics
# stay exempt, which is what keeps Fly's 6PN metrics scrape off this check.
OriginLock__AllowedHosts__0=

# --- Abuse controls (Phase 6e.1) ---
# Defaults are reasoned, not tuned against real traffic, nothing is deployed yet (DH.1/DH.2 open).
RateLimiting__Enabled=true
RateLimiting__Global__PermitsPerMinute=600
# Phase 8.4: with Redis configured, the HTTP limiter partitions are shared across instances so N
# machines do not mean N× every limit. Set false to fall back to per-instance limiting without
# giving up Redis for anything else.
RateLimiting__Distributed=true

# --- Hub connection budget (Phase 10a.2) ---
# Live SignalR connections one client IP (MaxConnectionsPerIp) or one anonymous caller
# (MaxAnonymousConnections) may hold across /hubs/game + /hubs/presence. Enabled=false counts
# nothing and refuses nobody. See docs/ops/DEPLOYMENT.md § 4.1 "Who gets the budget" for the
# derivation behind these two numbers.
Hub__ConnectionBudget__Enabled=true
Hub__ConnectionBudget__MaxConnectionsPerIp=20
Hub__ConnectionBudget__MaxAnonymousConnections=600

# --- Data retention (Phase 8a.3) ---
# The daily sweep that erases what docs/decisions/RETENTION.md says should not be kept indefinitely.
# Enabled=false stops the sweep and changes nothing else. See DEPLOYMENT.md § 5.1.
Retention__Enabled=true
Retention__SweepIntervalHours=24
Retention__InitialDelaySeconds=60
Retention__RefreshTokenGraceDays=30
Retention__ExternalCodeGraceDays=1
Retention__ApiTokenGraceDays=30
Retention__BanEvasionMarkerGraceDays=30

# --- Frontend (build-time; inlined by Next) ---
NEXT_PUBLIC_API_BASE=http://localhost:5053
NEXT_PUBLIC_SENTRY_DSN=
# Canonical origin used for robots.txt, sitemap.xml and openGraph/twitter absolute URLs (Phase 9d.6).
# No trailing slash. Same "build-time, inlined" caveat as NEXT_PUBLIC_API_BASE above.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile widget on /login's register tab (DH.3). Empty = no widget renders and
# registration is not blocked client-side on a token - see Turnstile__SecretKey below for the
# server-side half. The safe-to-commit sitekey lives in fly.ui.toml's [build.args].
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Names present in ui/.env.local and ui/.env.development.local. No source file reads either;
# leave them unset.
# NEXT_PUBLIC_LEADERBOARD_SAMPLES=
# NEXT_PUBLIC_PROFILE_SAMPLES=

# Runtime (server-side rendering); may differ from the client DSN or be the same project.
SENTRY_DSN=

# --- Multi-instance scale (Phase 8.4) ---
# Empty = single-instance: no backplane, no cross-instance ownership, no shared presence. This is the
# correct value until more than one machine is actually running. Under compose the redis service is
# on the default network, so `redis:6379` is all that is needed.
Redis__Configuration=

# --- Moderation (Phase 8.5) ---
# Emails that get the Admin role at boot. Unset means no moderator exists and /api/moderation 403s for
# everyone, which is the intended default. Array form, so index each entry:
# Moderation__AdminEmails__0=you@example.com
# Moderation__AdminEmails__1=them@example.com

# --- Ban-evasion marker (S-3-1) ---
# HMAC key for the pseudonymous marker written onto a banned account's tombstone at erasure, and
# checked at registration, so that deleting a banned account and signing up again with the same
# address is refused. TERMS section 6 promises exactly that. Empty = the marker is never written and
# registration is never refused on one, same "empty config = off" pattern as Turnstile__SecretKey and
# Email__ApiKey above, so a bare checkout and every test stay inert.
# Generate one with: openssl rand -base64 48
# PowerShell: $b=New-Object byte[] 48;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
# Rotating it invalidates every marker already written - see docs/ops/DEPLOYMENT.md section 9.2.
BanEvasion__MarkerSecret=

# --- Transactional email (Phase 8a.1) ---
# Empty key = email is logged and never sent (LoggingEmailSender), the same fail-closed pattern as
# Sentry__Dsn. Get a key at https://resend.com/api-keys. Email__FromAddress must be on a domain
# verified in Resend (SPF + DKIM records) or every send is rejected - see docs/ops/DEPLOYMENT.md.
Email__ApiKey=
Email__FromAddress=
Email__FromName=KiriChess
# Delivery is queued in-process and drained by a background service: these are that queue's dials.
# MaxAttempts counts the first attempt, so 4 means one send plus three retries at 1s/2s/4s.
Email__TimeoutSeconds=10
Email__MaxAttempts=4
Email__QueueCapacity=512

# --- Web push (Phase 11b.1 follow-up) ---
# Empty = push is never attempted, same fail-closed pattern as Email__ApiKey above. Generate a pair
# with: npx web-push generate-vapid-keys
Vapid__PublicKey=
Vapid__PrivateKey=
# A mailto: or https: URI identifying the sender, required by the push protocol.
Vapid__Subject=

# --- Donations / patron badge (Stripe webhook) ---
# Empty = every webhook delivery is rejected with a 500 (StripeWebhookEndpoints logs "Stripe
# WebhookSecret is not configured" and returns before touching the event), unlike the silent-noop
# fail-closed pattern above: the donation reference and payment link still work, but no checkout is
# ever confirmed and no patron badge is ever granted until this is set. Get the signing secret from
# the Stripe dashboard for the webhook endpoint used by docs/ops/PATRON-BADGE-GOLIVE.md.
Stripe__WebhookSecret=

# --- Public site origin ---
# Every link in every email is built from this, and Google sign-in redirects back to it (6b.3).
# No trailing slash. Email delivery stays switched off until it is set.
Frontend__BaseUrl=http://localhost:3000

# --- Public API origin (optional) ---
# The API's own public host, which is NOT the site's: see the DNS table in docs/ops/DEPLOYMENT.md.
# No trailing slash. Only one thing reads it: RFC 8058 one-click unsubscribe (M-5-2). A mail
# client's native Unsubscribe button POSTs with no JavaScript and no page render, so it needs the
# API directly rather than the /unsubscribe page a human clicks.
# Leaving this empty is safe and silent, which is the catch: reach-back mail then ships a plain
# List-Unsubscribe header naming the footer link, with no one-click promise, and nothing warns you.
# Set it in production or the one-click half of that feature is inert.
Api__BaseUrl=

# --- Matchmaking abuse controls (Phase 6e.3) ---
# Matchmaking__AbandonThreshold=0 disables the abandonment cooldown; Matchmaking__JoinDeadlineSeconds=0
# disables the no-show watcher. Both default to real, on-by-default values (see appsettings.json).
Matchmaking__JoinDeadlineSeconds=45
Matchmaking__AbandonWindowHours=24
Matchmaking__AbandonThreshold=3
Matchmaking__AbandonCooldownMinutes=15
